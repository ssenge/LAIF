import Mathlib

/-!
# Patterns that are periodic along a lattice

Cells are points of `ℤ × ℤ`, and `Sq c s` is the square of side `s` with corner `c`. A subgroup `Λ` *covers*
side `s` if every square of side `s` meets every coset of `Λ`. The pattern `P` on the square of side `m` agrees
with a `Λ`-periodic array `Q`.

* `closure_small`: a subgroup that covers side `s` is generated by its elements of max-norm at most `s`.
* `period_lift`: a period of `P` of max-norm at most `m - s` is a period of `Q`.
* `periodGroup_eq`: for `2 s ≤ m`, the periods of `Q` are generated by the periods of `P` of max-norm at most `s`.
* `occ_iff_phase`: if the window at `x` agrees with a class representative map `rep`, the pattern occurs at `x`
  iff `T ∘ rep` shifted by `x` equals `Q`.
* `occ_valid`: an occurrence has a window that agrees with `T ∘ rep` when `rep` maps into the window.
* `phase_unique`, `sample_pass`: such phases form one coset of the period group of `Q`, and a deterministic
  sample of the copies of `Q` is passed exactly by this coset.
-/

namespace PatternMatch

/-- The square of side `s` with corner `c`. -/
def Sq (c : ℤ × ℤ) (s : ℤ) : Set (ℤ × ℤ) := {z | c.1 ≤ z.1 ∧ z.1 < c.1 + s ∧ c.2 ≤ z.2 ∧ z.2 < c.2 + s}

/-- Every square of side `s` meets every coset of `Λ`. -/
def Covers (Λ : AddSubgroup (ℤ × ℤ)) (s : ℤ) : Prop := ∀ c w : ℤ × ℤ, ∃ z ∈ Sq c s, z - w ∈ Λ

/-- The periods of an array on `ℤ × ℤ`. -/
def periodGroup {α : Type*} (Q : ℤ × ℤ → α) : AddSubgroup (ℤ × ℤ) where
  carrier := {δ | ∀ w, Q (w + δ) = Q w}
  zero_mem' := by intro w; simp
  add_mem' := by
    intro a b ha hb w
    rw [← add_assoc, hb, ha]
  neg_mem' := by
    intro a ha w
    have := ha (w + -a)
    rw [neg_add_cancel_right] at this
    exact this.symm

/-- `δ` is a period of the pattern `P` on the square of side `m`. -/
def IsPer2 {α : Type*} (P : ℤ × ℤ → α) (m : ℤ) (δ : ℤ × ℤ) : Prop :=
  ∀ u, u ∈ Sq 0 m → u + δ ∈ Sq 0 m → P u = P (u + δ)

theorem covers_mono {Λ Γ : AddSubgroup (ℤ × ℤ)} {s : ℤ} (h : Λ ≤ Γ) (hc : Covers Λ s) : Covers Γ s := by
  intro c w
  obtain ⟨z, hz, hzw⟩ := hc c w
  exact ⟨z, hz, h hzw⟩

/-- A subgroup that covers side `s` is generated by its elements of max-norm at most `s`. -/
theorem closure_small {Λ : AddSubgroup (ℤ × ℤ)} {s : ℤ} (hc : Covers Λ s) :
    Λ ≤ AddSubgroup.closure {δ | δ ∈ Λ ∧ |δ.1| ≤ s ∧ |δ.2| ≤ s} := by
  set S := AddSubgroup.closure {δ : ℤ × ℤ | δ ∈ Λ ∧ |δ.1| ≤ s ∧ |δ.2| ≤ s}
  let F : ℤ × ℤ → Prop := fun c => ∀ q ∈ Λ, q ∈ Sq c s → q ∈ S
  have step : ∀ c c' : ℤ × ℤ, |c'.1 - c.1| ≤ 1 → |c'.2 - c.2| ≤ 1 → F c → F c' := by
    intro c c' h1 h2 hF q hq hqs
    obtain ⟨z, hz, hz0⟩ := hc c 0
    rw [sub_zero] at hz0
    have hzS := hF z hz0 hz
    have hd : q - z ∈ S := by
      apply AddSubgroup.subset_closure
      refine ⟨sub_mem hq hz0, ?_, ?_⟩
      · obtain ⟨a1, a2, -, -⟩ := hz
        obtain ⟨b1, b2, -, -⟩ := hqs
        simp only [Prod.fst_sub]
        rw [abs_le] at h1 ⊢
        constructor <;> omega
      · obtain ⟨-, -, a3, a4⟩ := hz
        obtain ⟨-, -, b3, b4⟩ := hqs
        simp only [Prod.snd_sub]
        rw [abs_le] at h2 ⊢
        constructor <;> omega
    have := add_mem hzS hd
    rwa [add_sub_cancel] at this
  have base : F 0 := by
    intro q hq hqs
    apply AddSubgroup.subset_closure
    obtain ⟨a1, a2, a3, a4⟩ := hqs
    simp only [Prod.fst_zero, Prod.snd_zero, zero_add] at a1 a2 a3 a4
    refine ⟨hq, ?_, ?_⟩ <;> rw [abs_le] <;> constructor <;> omega
  have row : ∀ a : ℤ, F (a, 0) := by
    intro a
    induction a using Int.induction_on with
    | zero => exact base
    | succ i ih => exact step _ _ (by simp only [abs_le]; omega) (by simp only [abs_le]; omega) ih
    | pred i ih => exact step _ _ (by simp only [abs_le]; omega) (by simp only [abs_le]; omega) ih
  have all : ∀ c : ℤ × ℤ, F c := by
    rintro ⟨a, b⟩
    induction b using Int.induction_on with
    | zero => exact row a
    | succ i ih => exact step _ _ (by simp only [abs_le]; omega) (by simp only [abs_le]; omega) ih
    | pred i ih => exact step _ _ (by simp only [abs_le]; omega) (by simp only [abs_le]; omega) ih
  intro l hl
  have hs : 0 < s := by
    obtain ⟨z, hz, -⟩ := hc 0 0
    obtain ⟨a1, a2, -, -⟩ := hz
    simp only [Prod.fst_zero, zero_add] at a1 a2
    omega
  exact all l l hl ⟨le_refl _, by omega, le_refl _, by omega⟩

/-- A period of `P` of max-norm at most `m - s` is a period of the `Λ`-periodic array `Q` that agrees with `P`,
when `Λ` covers side `s`. -/
theorem period_lift {α : Type*} {Λ : AddSubgroup (ℤ × ℤ)} {s m : ℤ} (hc : Covers Λ s)
    {Q P : ℤ × ℤ → α} (hQ : Λ ≤ periodGroup Q) (hP : ∀ u ∈ Sq 0 m, P u = Q u) {δ : ℤ × ℤ}
    (hδ : IsPer2 P m δ) (h1 : |δ.1| ≤ m - s) (h2 : |δ.2| ≤ m - s) : δ ∈ periodGroup Q := by
  intro w
  obtain ⟨z, hz, hzw⟩ := hc (max 0 (-δ.1), max 0 (-δ.2)) w
  obtain ⟨a1, a2, a3, a4⟩ := hz
  simp only at a1 a2 a3 a4
  rw [abs_le] at h1 h2
  have hz0 : z ∈ Sq 0 m := by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [Prod.fst_zero, Prod.snd_zero, zero_add] <;> omega
  have hzd : z + δ ∈ Sq 0 m := by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [Prod.fst_zero, Prod.snd_zero, zero_add, Prod.fst_add,
      Prod.snd_add] <;> omega
  have e1 : Q z = Q w := by
    have := hQ hzw w
    rwa [add_sub_cancel] at this
  have e2 : Q (z + δ) = Q (w + δ) := by
    have := hQ hzw (w + δ)
    rw [show w + δ + (z - w) = z + δ by abel] at this
    exact this
  rw [← e1, ← e2, ← hP z hz0, ← hP _ hzd]
  exact (hδ z hz0 hzd).symm

/-- For `2 s ≤ m`, the periods of the `Λ`-periodic extension `Q` of `P` are generated by the periods of `P` of
max-norm at most `s`. -/
theorem periodGroup_eq {α : Type*} {Λ : AddSubgroup (ℤ × ℤ)} {s m : ℤ} (hc : Covers Λ s) (hsm : 2 * s ≤ m)
    {Q P : ℤ × ℤ → α} (hQ : Λ ≤ periodGroup Q) (hP : ∀ u ∈ Sq 0 m, P u = Q u) :
    periodGroup Q = AddSubgroup.closure {δ | IsPer2 P m δ ∧ |δ.1| ≤ s ∧ |δ.2| ≤ s} := by
  apply le_antisymm
  · refine le_trans (closure_small (covers_mono hQ hc)) (AddSubgroup.closure_mono ?_)
    rintro δ ⟨hδ, h1, h2⟩
    refine ⟨?_, h1, h2⟩
    intro u hu hud
    rw [hP u hu, hP _ hud]
    exact (hδ u).symm
  · rw [AddSubgroup.closure_le]
    rintro δ ⟨hδ, h1, h2⟩
    exact period_lift hc hQ hP hδ (by omega) (by omega)

/-- **Occurrence and phase.** Let `Q` be `Γ`-periodic and agree with `P` on the square of side `m`, which meets
every coset of `Γ`, and let `rep` be constant on cosets. If the window at `x` agrees with `T ∘ rep`, the pattern
occurs at `x` iff `T (rep (x + w)) = Q w` for every `w`. -/
theorem occ_iff_phase {α : Type*} {Γ : AddSubgroup (ℤ × ℤ)} {m : ℤ} {Q P T : ℤ × ℤ → α}
    {rep : ℤ × ℤ → ℤ × ℤ} (hQ : Γ ≤ periodGroup Q) (hP : ∀ u ∈ Sq 0 m, P u = Q u)
    (hbox : ∀ w, ∃ u ∈ Sq 0 m, u - w ∈ Γ) (hrep : ∀ w w', w - w' ∈ Γ → rep w = rep w') {x : ℤ × ℤ}
    (hV : ∀ u ∈ Sq 0 m, T (x + u) = T (rep (x + u))) :
    (∀ u ∈ Sq 0 m, T (x + u) = P u) ↔ ∀ w, T (rep (x + w)) = Q w := by
  constructor
  · intro hocc w
    obtain ⟨u, hu, huw⟩ := hbox w
    have hr : rep (x + w) = rep (x + u) := by
      apply hrep
      rw [show x + w - (x + u) = -(u - w) by abel]
      exact neg_mem huw
    have hq : Q u = Q w := by
      have := hQ huw w
      rwa [add_sub_cancel] at this
    rw [hr, ← hV u hu, hocc u hu, hP u hu, hq]
  · intro hph u hu
    rw [hV u hu, hph u, hP u hu]

/-- An occurrence has a valid window: if `rep (x + u)` is a cell `x + u'` of the window with `u' - u ∈ Γ`, then
`T (x + u) = T (rep (x + u))`. -/
theorem occ_valid {α : Type*} {Γ : AddSubgroup (ℤ × ℤ)} {m : ℤ} {Q P T : ℤ × ℤ → α}
    {rep : ℤ × ℤ → ℤ × ℤ} (hQ : Γ ≤ periodGroup Q) (hP : ∀ u ∈ Sq 0 m, P u = Q u) {x : ℤ × ℤ}
    (hr : ∀ u ∈ Sq 0 m, ∃ u' ∈ Sq 0 m, rep (x + u) = x + u' ∧ u' - u ∈ Γ)
    (hocc : ∀ u ∈ Sq 0 m, T (x + u) = P u) : ∀ u ∈ Sq 0 m, T (x + u) = T (rep (x + u)) := by
  intro u hu
  obtain ⟨u', hu', he, hd⟩ := hr u hu
  have hq : Q u' = Q u := by
    have := hQ hd u
    rwa [add_sub_cancel] at this
  rw [he, hocc u hu, hocc u' hu', hP u hu, hP u' hu', hq]

/-- Two phases of the same array differ by a period of `Q`. -/
theorem phase_unique {α : Type*} {Q F : ℤ × ℤ → α} {x y : ℤ × ℤ} (hx : ∀ w, F (x + w) = Q w)
    (hy : ∀ w, F (y + w) = Q w) : y - x ∈ periodGroup Q := by
  intro w
  rw [← hx, ← hy]
  congr 1
  abel

/-- **The sample on the torus.** If the copies `Q (· - j)` that agree with the values `c t` at the cells `g t` are
exactly those with `j - f ∈ Γ`, and `F` has the phase `x`, then a candidate `ψ` passes the sample iff
`ψ - x ∈ Γ`. -/
theorem sample_pass {α : Type*} {Γ : AddSubgroup (ℤ × ℤ)} {Q F : ℤ × ℤ → α} {k : ℕ} {g : Fin k → ℤ × ℤ}
    {c : Fin k → α} {f x : ℤ × ℤ} (hs : ∀ j, (∀ t, Q (g t - j) = c t) ↔ j - f ∈ Γ)
    (hx : ∀ w, F (x + w) = Q w) (ψ : ℤ × ℤ) :
    (∀ t, F (g t + ψ - f) = c t) ↔ ψ - x ∈ Γ := by
  have e : ∀ t, F (g t + ψ - f) = Q (g t - (f + x - ψ)) := by
    intro t
    rw [← hx]
    congr 1
    abel
  simp only [e]
  rw [hs, show f + x - ψ - f = -(ψ - x) by abel, neg_mem_iff]

end PatternMatch
