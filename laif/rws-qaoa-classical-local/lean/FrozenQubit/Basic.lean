import Mathlib

/-!
# Frozen qubits in warm-started QAOA

Amplitude vectors are indexed by the computational basis `Fin n → Bool`. A layer of warm-started QAOA is a product of
a diagonal cost unitary and single-qubit mixer unitaries. If the warm-start state of qubit `i` is a basis state, its
mixer is generated by `± Z` and is diagonal. Every layer then keeps the value of qubit `i`, and the measured expectation
of any objective is at most its maximum over the basis states that agree with the warm start on the frozen qubits.
-/

open Finset

namespace FrozenQubit

variable {n : ℕ}

/-- Computational basis states of `n` qubits. -/
abbrev Basis (n : ℕ) := Fin n → Bool

/-- The matrix moves no amplitude between basis states that differ at qubit `i`. -/
def KeepsQubit (i : Fin n) (M : Matrix (Basis n) (Basis n) ℂ) : Prop :=
  ∀ z w : Basis n, z i ≠ w i → M z w = 0

/-- The vector vanishes on every basis state whose qubit `i` differs from `a`. -/
def SupportedAt (i : Fin n) (a : Bool) (v : Basis n → ℂ) : Prop :=
  ∀ z : Basis n, z i ≠ a → v z = 0

/-- The single-qubit matrix `u` acting on qubit `q`, and as the identity on the other qubits. -/
def onQubit (q : Fin n) (u : Matrix Bool Bool ℂ) : Matrix (Basis n) (Basis n) ℂ :=
  fun z w => if ∀ j, j ≠ q → z j = w j then u (z q) (w q) else 0

/-- The product state with single-qubit amplitudes `c q`. -/
def productState (c : Fin n → Bool → ℂ) : Basis n → ℂ := fun z => ∏ q, c q (z q)

/-- The layers allowed by the warm-started circuit when the qubits in `F` are polarized: diagonal matrices (the cost),
single-qubit matrices on qubits outside `F`, and diagonal single-qubit matrices on any qubit (the mixer `exp(∓ iβZ)`). -/
def Allowed (F : Finset (Fin n)) (M : Matrix (Basis n) (Basis n) ℂ) : Prop :=
  (∃ d, M = Matrix.diagonal d) ∨
    ∃ q u, M = onQubit q u ∧ (q ∉ F ∨ ∀ a b : Bool, a ≠ b → u a b = 0)

theorem keepsQubit_diagonal (i : Fin n) (d : Basis n → ℂ) : KeepsQubit i (Matrix.diagonal d) := by
  intro z w h
  exact Matrix.diagonal_apply_ne d (fun e => h (e ▸ rfl))

theorem keepsQubit_onQubit_ne {i q : Fin n} (h : q ≠ i) (u : Matrix Bool Bool ℂ) :
    KeepsQubit i (onQubit q u) := by
  intro z w hzw
  simp only [onQubit]
  rw [ite_eq_right_iff]
  intro hall
  exact absurd (hall i (Ne.symm h)) hzw

theorem keepsQubit_onQubit_diag (i : Fin n) (u : Matrix Bool Bool ℂ) (hu : ∀ a b : Bool, a ≠ b → u a b = 0) :
    KeepsQubit i (onQubit i u) := by
  intro z w hzw
  simp only [onQubit]
  split_ifs
  · exact hu _ _ hzw
  · rfl

theorem keepsQubit_one (i : Fin n) : KeepsQubit i (1 : Matrix (Basis n) (Basis n) ℂ) := by
  intro z w h
  exact Matrix.one_apply_ne (fun e => h (e ▸ rfl))

theorem keepsQubit_mul {i : Fin n} {M N : Matrix (Basis n) (Basis n) ℂ} (hM : KeepsQubit i M)
    (hN : KeepsQubit i N) : KeepsQubit i (M * N) := by
  intro z w hzw
  rw [Matrix.mul_apply]
  apply Finset.sum_eq_zero
  intro u _
  by_cases hu : z i = u i
  · rw [hN u w (by rw [← hu]; exact hzw), mul_zero]
  · rw [hM z u hu, zero_mul]

theorem keepsQubit_prod {i : Fin n} (L : List (Matrix (Basis n) (Basis n) ℂ)) (h : ∀ M ∈ L, KeepsQubit i M) :
    KeepsQubit i L.prod := by
  induction L with
  | nil => exact keepsQubit_one i
  | cons M L ih =>
    rw [List.prod_cons]
    exact keepsQubit_mul (h M List.mem_cons_self) (ih fun N hN => h N (List.mem_cons_of_mem M hN))

theorem Allowed.keeps {F : Finset (Fin n)} {M : Matrix (Basis n) (Basis n) ℂ} (h : Allowed F M) {i : Fin n}
    (hi : i ∈ F) : KeepsQubit i M := by
  rcases h with ⟨d, rfl⟩ | ⟨q, u, rfl, hq⟩
  · exact keepsQubit_diagonal i d
  · by_cases hqi : q = i
    · subst hqi
      rcases hq with hq | hu
      · exact absurd hi hq
      · exact keepsQubit_onQubit_diag q u hu
    · exact keepsQubit_onQubit_ne hqi u

theorem mulVec_supportedAt {i : Fin n} {a : Bool} {M : Matrix (Basis n) (Basis n) ℂ} {v : Basis n → ℂ}
    (hM : KeepsQubit i M) (hv : SupportedAt i a v) : SupportedAt i a (M.mulVec v) := by
  intro z hz
  simp only [Matrix.mulVec, dotProduct]
  apply Finset.sum_eq_zero
  intro w _
  by_cases hw : w i = a
  · rw [hM z w (by rw [hw]; exact hz), zero_mul]
  · rw [hv w hw, mul_zero]

theorem productState_supportedAt {c : Fin n → Bool → ℂ} {i : Fin n} {a : Bool} (h : ∀ b, b ≠ a → c i b = 0) :
    SupportedAt i a (productState c) := by
  intro z hz
  exact Finset.prod_eq_zero (Finset.mem_univ i) (h _ hz)

/-- **Frozen qubits.** Start from a product state in which every qubit `i ∈ F` is the basis state `a i`, and apply any
product of allowed layers. The final state vanishes on every basis state that disagrees with `a` on `F`. -/
theorem frozen (F : Finset (Fin n)) (a : Fin n → Bool) (c : Fin n → Bool → ℂ)
    (hc : ∀ i ∈ F, ∀ b, b ≠ a i → c i b = 0) (L : List (Matrix (Basis n) (Basis n) ℂ))
    (hL : ∀ M ∈ L, Allowed F M) (z : Basis n) (hz : ∃ i ∈ F, z i ≠ a i) :
    L.prod.mulVec (productState c) z = 0 := by
  obtain ⟨i, hi, hne⟩ := hz
  exact mulVec_supportedAt (keepsQubit_prod L fun M hM => (hL M hM).keeps hi)
    (productState_supportedAt (hc i hi)) z hne

/-- **Ceiling.** Under the hypotheses of `frozen`, for a normalized final state, the expected value of any objective
`f` in the computational basis is at most any bound `C` on `f` over the basis states that agree with `a` on `F`. -/
theorem expected_le_ceiling (F : Finset (Fin n)) (a : Fin n → Bool) (c : Fin n → Bool → ℂ)
    (hc : ∀ i ∈ F, ∀ b, b ≠ a i → c i b = 0) (L : List (Matrix (Basis n) (Basis n) ℂ))
    (hL : ∀ M ∈ L, Allowed F M) (f : Basis n → ℝ) (C : ℝ) (hC : ∀ z, (∀ i ∈ F, z i = a i) → f z ≤ C)
    (hnorm : ∑ z, ‖L.prod.mulVec (productState c) z‖ ^ 2 = 1) :
    ∑ z, ‖L.prod.mulVec (productState c) z‖ ^ 2 * f z ≤ C := by
  calc ∑ z, ‖L.prod.mulVec (productState c) z‖ ^ 2 * f z
      ≤ ∑ z, ‖L.prod.mulVec (productState c) z‖ ^ 2 * C := by
        apply Finset.sum_le_sum
        intro z _
        by_cases hz : ∀ i ∈ F, z i = a i
        · exact mul_le_mul_of_nonneg_left (hC z hz) (by positivity)
        · push Not at hz
          rw [frozen F a c hc L hL z hz]
          simp
    _ = C := by rw [← Finset.sum_mul, hnorm, one_mul]

end FrozenQubit
